    "mcp.config.usrlocalmcp.Playwright",
    "mcp.config.usrlocalmcp.TaskManager",
    "mcp.config.usrlocalmcp.Context 7",
    "mcp.config.usrlocalmcp.Memory",
    "mcp.config.usrlocalmcp.Sequential Thinking",
    "mcp.config.usrlocalmcp.Excel",
    "mcp.config.usrlocalmcp.FFmpeg Video Processor",
    "mcp.config.usrlocalmcp.FileSystem"
