          "mode": "id"
        },
        "messages": {
          "values": [
            {
              "content": "=You are to determine the date to get. If the text message asks to get calendar for today then your output should be todays date. \n\n- For example, if todays date is the 10th of September 2024, then your output should be '2024-09-10 00:00:00'\n\n- For example, if the text asks to get calendar from yesterday and the date is 10th of September 2024 then your output should be '2024-09-09 00:00:00'\n\n- For example, if the message asks to get calendar for next week and todays date is the 7th of September 2024 then your output should be the next Monday which would be'2024-09-16 00:00:00'\n\nHere is the message you are to analyze to see what date it is talking about: {{ $('Twilio Trigger').item.json.data.body }} \n\nHere's the current date: {{ $json.currentDate }}\n\nYour only output should say the date like this (example, you must change the dates when necessary and not use the 10th like in this example): 2024-09-10 00:00:00\n\nIt should never say anything more",
              "role": "system"
            }
          ]
        },
        "options": {}
      },
      "id": "6e0b42ad-3da2-4838-a39e-c302a2b0d573",
