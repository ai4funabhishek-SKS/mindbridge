        "jsCode": "// Get all input items (each row)\nconst items = $input.all();\n\n// Filter for items that have a download_url\nconst withDownloadUrl = items.filter(item => item.json.asset?.url);\n\n// If no such item found, return nothing\nif (withDownloadUrl.length === 0) {\n  return [];\n}\n\n// Sort by created_at (if available) or use last item\nwithDownloadUrl.sort((a, b) => {\n  const timeA = new Date(a.json.created_at || 0).getTime();\n  const timeB = new Date(b.json.created_at || 0).getTime();\n  return timeB - timeA; // latest first\n});\n\n// Get the latest one\nconst latest = withDownloadUrl[0];\n\n// Return the url only\nreturn [\n  {\n    json: {\n      url: latest.json.asset.url\n    }\n  }\n];\n"
      },
