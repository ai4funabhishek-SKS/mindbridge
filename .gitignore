# Private Vault Folder (Strict Security Protection - Confidential Personal Data)
01_Vault_Private/

# M5 Phase 1 (2026-08-23): Raw originals include live API keys, Aadhaar ID,
# bank statements & CVs — see Processed_Assets/credential_audit.json.
# The entire raw tier stays OUT of git history. Files remain safe on disk.
Raw_copies/

# Environment, Secrets & Local Credentials
.env
*.env
*.env.txt
*.key
*secret*
*credential*
*credentials*

# Temporary, Office Lock & OS Junk Files
.~lock.*#
.~lock*#
~$*
*.tmp
*.temp
*.log
*.bak
*.old
*.wbk
*.dmp

# Python Cache & Build Artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# System Metadata Files
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Agent Scratch Directories (Keep Documentation & Handoffs Intact)
.agents/*/scratch/

